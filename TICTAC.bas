540 REM MACHINE MOVE
550 P=ASC("O")
560 X=0
570 J=1
580 IF GB(WB(J))=GB(WB(J+1)) AND GB(WB(J+2))=32 AND GB(WB(J))=P THEN X=WB(J+2):GOTO 750
590 IF GB(WB(J))=GB(WB(J+2)) AND GB(WB(J+1))=32 AND GB(WB(J))=P THEN X=WB(J+1):GOTO 750
600 IF GB(WB(J+1))=GB(WB(J+2)) AND GB(WB(J))=32 AND GB(WB(J+1))=P THEN X=WB(J+1):GOTO 750
610 IF J<21 THEN J=J+3:GOTO 580
620 IF P=ASC("O") THEN P=ASC("X"):GOTO 570
630 REM ** IF NO WIN/BLOCK MOVE FOUND **
640 REM ** THEN THIS NEXT SECTION USED **
650 J=1
660 IF GB(KB(J))=32 THEN X=KB(J):GOTO 750
670 IF J<10 THEN J=J+1:GOTO 660
680 H=0
690 H=H+1
700 X = INT(RND(1)*9):IF GB(X)=32 THEN 750
710 IF H<100 THEN 690
720 R$="D":REM IT IS A DRAW
730 RETURN
740 REM *********


750 REM MAKE MOVE
760 GB(X)=ASC("O")
770 COUNT=COUNT+1
780 MQ(COUNT)=X
790 FLAG=0
800 FOR J=1 TO 9
810 IF GB(J)=32 THEN FLAG=1
820 NEXT J
830 IF FLAG=0 AND R$="" THEN R$="D"
840 REM IF ALL POSITIONS FULL, AND R$ NOT ASSIGNED, IT IS A DRAW
850 RETURN
860 REM *********


870 REM WIN CHECK
880 J=1
890 IF GB(WB(J))=32 THEN J=J+3
900 IF J>23 THEN RETURN
910 IF GB(WB(J))=GB(WB(J+1)) AND GB(WB(J))=GB(WB(J+2)) THEN 940
920 IF J<22 THEN J=J+3:GOTO 890
930 RETURN
940 IF GB(WB(J))=ASC("O") THEN R$="W":REM MACHINE WINS
950 IF GB(WB(J))=ASC("X") THEN R$="L":REM MACHINE LOSES
960 RETURN
